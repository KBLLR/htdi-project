{
  "title": "HTDI Controls",
  "expanded": true,
  "children": [
    {
      "type": "folder",
      "title": "Camera",
      "children": [
        { "type": "binding", "path": "camera.position.x", "label": "Pos X" },
        { "type": "binding", "path": "camera.position.y", "label": "Pos Y" },
        { "type": "binding", "path": "camera.position.z", "label": "Pos Z" },
        {
          "type": "binding",
          "path": "camera.fov",
          "label": "FOV",
          "min": 10,
          "max": 150,
          "step": 1
        },
        {
          "type": "button",
          "title": "Overview Preset",
          "handler": "animateCameraPreset",
          "args": ["overview"]
        },
        {
          "type": "button",
          "title": "Focus Preset",
          "handler": "animateCameraPreset",
          "args": ["focus"]
        }
      ]
    },
    {
      "type": "folder",
      "title": "Controls",
      "children": [
        { "type": "binding", "path": "controls.enabled", "label": "Enabled" },
        {
          "type": "binding",
          "path": "controls.autoRotate",
          "label": "Auto Rotate"
        },
        {
          "type": "binding",
          "path": "controls.autoRotateSpeed",
          "label": "AutoRot Speed",
          "min": -10,
          "max": 10,
          "step": 0.1
        },
        {
          "type": "binding",
          "path": "controls.enableDamping",
          "label": "Damping On"
        },
        {
          "type": "binding",
          "path": "controls.dampingFactor",
          "label": "Damping",
          "min": 0.01,
          "max": 0.25,
          "step": 0.005
        },
        {
          "type": "binding",
          "path": "controls.minDistance",
          "label": "Min Dist",
          "min": 0.01,
          "max": 20,
          "step": 0.01
        },
        {
          "type": "binding",
          "path": "controls.maxDistance",
          "label": "Max Dist",
          "min": 0.1,
          "max": 100,
          "step": 0.1
        }
      ]
    },
    {
      "type": "folder",
      "title": "Lights",
      "children": [
        {
          "type": "binding",
          "path": "sceneRegistry.lights.directional.ref.intensity",
          "label": "Dir Intensity",
          "min": 0,
          "max": 5,
          "step": 0.01
        },
        {
          "type": "binding",
          "path": "sceneRegistry.lights.directional.ref.position.x",
          "label": "Dir X"
        },
        {
          "type": "binding",
          "path": "sceneRegistry.lights.directional.ref.position.y",
          "label": "Dir Y"
        },
        {
          "type": "binding",
          "path": "sceneRegistry.lights.directional.ref.position.z",
          "label": "Dir Z"
        },
        { "type": "separator" },
        {
          "type": "binding",
          "path": "sceneRegistry.lights.rotatingPoints[0].ref.intensity",
          "label": "P1 Int",
          "min": 0,
          "max": 20,
          "step": 0.01
        }
      ]
    },
    {
      "type": "folder",
      "title": "Materials",
      "children": [
        {
          "type": "binding",
          "path": "sceneRegistry.materials.alphaMat.ref.opacity",
          "label": "Outer Opacity",
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "type": "binding",
          "path": "sceneRegistry.materials.kidMaterial.ref.metalness",
          "label": "Kid Metalness",
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "type": "binding",
          "path": "sceneRegistry.materials.kidMaterial.ref.roughness",
          "label": "Kid Rough",
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      ]
    },
    {
      "type": "folder",
      "title": "DOF",
      "children": [
        {
          "type": "binding",
          "path": "depthOfFieldEffect.focusDistance",
          "label": "Focus Dist",
          "min": 0,
          "max": 1,
          "step": 0.001
        },
        {
          "type": "binding",
          "path": "depthOfFieldEffect.focalLength",
          "label": "Focal Len",
          "min": 0,
          "max": 0.2,
          "step": 0.0005
        },
        {
          "type": "binding",
          "path": "depthOfFieldEffect.bokehScale",
          "label": "Bokeh",
          "min": 0,
          "max": 10,
          "step": 0.1
        },
        {
          "type": "button",
          "title": "DOF Preset: Focus",
          "handler": "setDepthOfFieldPreset",
          "args": ["focus"]
        }
      ]
    },
    { "type": "fpsgraph", "label": "FPS" }
  ]
}
