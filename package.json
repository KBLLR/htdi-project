{
  "repository": "https://github.com/KBLLR/htdi-project",
  "license": "MIT",
  "name": "htdi-project",
  "version": "1.0.1",
  "type": "module",
  "description": "Hard To Debug Issues Project - Various experiments and projects focusing on 3D, WebGL, creative coding, and interactive experiences using libraries like Three.js, Pixi.js, A-Frame, and more.",
  "author": "David Caballero",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "start": "npm run dev",
    "lint": "eslint \"src/**/*.js\"",
    "test": "echo \"No tests configured\" && exit 0",
    "generate:assets": "node scripts/updateAssets.mjs",
    "fbx:glb": "BLENDER_BIN=\"/Applications/Blender.app/Contents/MacOS/Blender\" zsh scripts/convert_fbx_with_blender.zsh ./assets/fbx ./assets/gltf glb --recursive --verbose",
    "fbx:gltf:separate": "BLENDER_BIN=\"/Applications/Blender.app/Contents/MacOS/Blender\" zsh scripts/convert_fbx_with_blender.zsh ./assets/fbx ./assets/gltf gltf_separate --recursive --verbose"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@tweenjs/tween.js": "^25.0.0",
    "augmented-ui": "^2.0.0",
    "chroma-js": "^2.6.0",
    "gsap": "^3.13.0",
    "hsl-to-hex": "^1.0.0",
    "improved-noise": "^0.0.3",
    "lil-gui": "^0.21.0",
    "lodash": "^4.17.21",
    "popmotion": "^11.0.5",
    "postprocessing": "^6.37.8",
    "simplex-noise": "^4.0.3",
    "snd-lib": "^1.2.4",
    "stats.js": "^0.17.0",
    "three": "^0.180.0",
    "tippy.js": "^6.3.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tweakpane/plugin-essentials": "^0.2.1",
    "eslint": "^9.38.0",
    "ktx2-encoder": "^0.5.0",
    "potpack": "^2.1.0",
    "sharp": "^0.34.4",
    "tweakpane": "^4.0.5",
    "vite": "^7.1.12",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
